{
  "name": "signum-3d-icon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "electron . --dev-server=http://localhost:5173",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "lucide": "^0.462.0",
    "mediabunny": "^1.50.8",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.44.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "remixicon": "^4.9.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "studio.signum.icon3d",
    "productName": "Signum 3D Icon Studio",
    "files": [
      "dist/**",
      "electron/**",
      "branding/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "branding"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/get": "^5.0.0",
    "temp": {
      "rimraf": "^6.0.1"
    }
  }
}
